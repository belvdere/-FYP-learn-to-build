# Prompt Optimizer - copy to .fyp/.env
#
#   cp prompt-optimizer/.env.example .fyp/.env
#   # Edit .fyp/.env and add your OPENAI_API_KEY
#
# The MCP server loads .fyp/.env when spawning the TextGrad optimizer.
# See docs/TEXTGRAD_INTEGRATION.md for full setup.

# Required for prompt optimization (TextGrad backward pass)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: enable per-call snapshot optimization (set to 1)
# If not set here, use: export FYP_OPTIMIZE_PROMPTS=1
# FYP_OPTIMIZE_PROMPTS=1

# Optional: path to optimize.py (auto-resolved if not set)
# FYP_PROMPT_OPTIMIZER_PATH=/path/to/optimize.py

# Optional: subprocess timeout in seconds (default: 30)
# FYP_OPTIMIZE_TIMEOUT=30
